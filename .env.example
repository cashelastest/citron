# docker compose up — inside the compose network the database is on 5432
DATABASE_URL=postgresql+asyncpg://ledger_user:ledger_pass@db:5432/mini_ledger

# Database used by pytest, reached from the host.
# Dropped and recreated on every run — never point it at anything you care about.
TEST_DATABASE_URL=postgresql+asyncpg://ledger_user:ledger_pass@localhost:5432/citron_test

# Transfer fee as a fraction of the amount: 0.01 == 1%
FEE_PERCENT=0.01

DEBUG=false
