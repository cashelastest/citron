# Local run (Postgres on the host)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/citron

# docker compose up
# DATABASE_URL=postgresql+asyncpg://ledger_user:ledger_pass@db:5432/mini_ledger

# Database used by pytest; it is dropped and recreated on every run
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/citron_test

# Transfer fee as a fraction of the amount: 0.01 == 1%
FEE_PERCENT=0.01

DEBUG=false
